PORT=8787
HOST=127.0.0.1
# Relative paths are resolved from video-pull-up/.
CATALOG_PATH=data/demo-catalog.json
# Frontend origin, only needed when calling directly without a Vite proxy.
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional local model: unset OLLAMA_MODEL to use transcript extracts.
# OLLAMA_MODEL=your-installed-model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=30000
