# Copy to .env (never commit .env).
OPENAI_API_KEY=sk-...

# Model used to pre-translate pages and to translate live selections.
# `python -m viscon_translate models` lists the models your key can use.
TR_MODEL=

# Language to translate selected text into.
# TR_TARGET_LANG=English

# Optional overrides (relative to the translation/ folder).
# TR_PDF_DIR=.
# TR_INDEX_PATH=data/index.json
# TR_CACHE_PATH=data/cache.json
# TR_HOST=127.0.0.1
# TR_PORT=8788
