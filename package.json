{
  "name": "basis-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "start:production": "node --import tsx server/index.ts",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test": "node --import tsx --test tests/*.test.ts auth/*.test.ts admin/*.test.ts submissions/*.test.ts video-pull-up/test/*.test.mjs",
    "test:ui": ".venv/bin/python tests/run_browser.py",
    "auth": "tsx auth/cli.ts"
  },
  "dependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "express": "^5.3.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.54.0",
    "maplibre-gl": "^6.13.0",
    "nodemailer": "^10.0.16",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
