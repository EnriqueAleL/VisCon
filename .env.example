# Optional. Development runs Vite on 5173 and the API on 3001.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=.data/arena.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Set true when serving through HTTPS.
COOKIE_SECURE=false

# Optional private JSON question bank; replaces the demonstration questions.
# QUESTION_BANK_PATH=/absolute/path/to/questions.json

# Optional administrator-configured, isolated Judge0 instance.
# Set its enabled Java language ID; IDs vary between deployments.
# JUDGE0_URL=https://your-judge.example
# JUDGE0_JAVA_LANGUAGE_ID=your_java_language_id
# JUDGE0_API_KEY=your_auth_token

# Lecture search uses the local transcripts by default, with no paid model calls.
LECTURE_QA_PROVIDER=local
# Optional: use the existing Python Q&A pipeline instead (qa/.env holds its key/model).
# LECTURE_QA_PROVIDER=python
# QA_PYTHON=/absolute/path/to/python
# Optional local explanation model for the lexical search:
# OLLAMA_MODEL=your_local_model
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Docker/managed VIScon deployment. Compose binds 0.0.0.0:8080 regardless of PORT above.
# Set the actual team origin and include it in ALLOWED_ORIGINS (no spaces/trailing slash).
# APP_PUBLIC_URL=https://NN.hackathon.ethz.ch
# ALLOWED_ORIGINS=https://NN.hackathon.ethz.ch,http://localhost:8080,http://127.0.0.1:8080
# COOKIE_SECURE=true
# DOCKER_TARGET=runtime
# Optional Python Q&A image: DOCKER_TARGET=qa-runtime and LECTURE_QA_PROVIDER=python
# QA_PYTHON=/opt/qa-venv/bin/python
# OPENAI_API_KEY=your_backend_only_key
# QA_INDEX_MODEL=your_available_model
# QA_ANSWER_MODEL=your_available_model
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional paths to an already downloaded corpus; all mounts are read-only.
# LECTURES_DIR=./lectures
# QA_DATA_DIR=./qa/data
# DEMO_MEDIA_DIR=./video-pull-up/media
# Trust managed identity headers only with restricted proxy ingress. See the runbook.
MANIA_TRUST_PROXY=false
# MANIA_TRUSTED_PROXY_IPS=actual_proxy_ip_1,actual_proxy_ip_2
# Leave unset until a verified exam date is known (YYYY-MM-DD or ISO timestamp).
# EXAM_DATE=YYYY-MM-DD
# EXAM_LABEL=Basisprüfung

# ETH student email verification (auth/). Codes are mailed to <username>@student.ethz.ch.
# Option A, separate fields (no URL-encoding of the password needed). Port 465 = TLS, 587 = STARTTLS.
# AUTH_MAIL_FROM="VIScon <your.sender@example.org>"   # must be an address the SMTP account may send as
# AUTH_SMTP_HOST=smtp.gmail.com
# AUTH_SMTP_PORT=465
# AUTH_SMTP_USER=your.sender@example.org
# AUTH_SMTP_PASSWORD=app-password-here
# Option B, one URL instead (URL-encode special characters in the password):
# AUTH_SMTP_URL=smtps://user:password@smtp.example.org:465
# Check it from the VM: docker compose exec app npm run auth -- smtp-check you@student.ethz.ch
# Development only, prints the email (with the code) instead of sending it; refused when NODE_ENV=production:
# AUTH_MAIL_TRANSPORT=console
# AUTH_MAIL_DOMAIN=student.ethz.ch
# AUTH_DB_PATH=.data/auth.sqlite   # CLI only; the server keeps accounts in DATABASE_PATH

# Behind the managed proxy every request comes from the proxy's address. Name the header that carries the
# real client IP (for example x-forwarded-for) so login and email rate limits apply per person.
# AUTH_CLIENT_IP_HEADER=x-forwarded-for

# Everything under /api, /media and both Socket.IO namespaces requires an account with a confirmed ETH
# student email. Only /api/health and /api/auth/* stay open. There is no register/log-in screen yet,
# so set this to false for local front-end work until there is one. Never in production.
# AUTH_REQUIRE_VERIFIED=false

# A confirmed ETH mailbox counts this many days, then the student confirms again. 0 = never.
# AUTH_REVERIFY_DAYS=180
# How often open Socket.IO connections are re-checked against the guard (seconds). 0 = only at connect.
# AUTH_SOCKET_RECHECK_SECONDS=30
# One verification email per account per this many seconds (default 60). Lower only for tests.
# AUTH_RESEND_COOLDOWN_SECONDS=60

# Bootstrap administrators: ETH usernames, comma separated. They can create courses, other admins and course admins.
# Set here only, so nobody can promote themselves through the app. Compose defaults to riordache.
# AUTH_ADMINS=riordache

# Student-submitted material (submissions/). Files are stored here, never served directly, never committed.
# UPLOADS_DIR=.data/uploads
# UPLOAD_MAX_VIDEO_MB=2000
# UPLOAD_MAX_PDF_MB=100
# UPLOAD_MAX_TRANSCRIPT_MB=5
# UPLOAD_MAX_USER_DAY_MB=4000
# UPLOAD_MAX_TOTAL_MB=30000
# UPLOAD_MAX_PENDING_PER_USER=5
