# Optional. Development runs Vite on 5173 and the API on 3001.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=.data/arena.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Set true when serving through HTTPS.
COOKIE_SECURE=false

# Optional private JSON question bank; replaces the demonstration questions.
# QUESTION_BANK_PATH=/absolute/path/to/questions.json

# Optional administrator-configured, isolated Judge0 instance.
# Set its enabled Java language ID; IDs vary between deployments.
# JUDGE0_URL=https://your-judge.example
# JUDGE0_JAVA_LANGUAGE_ID=your_java_language_id
# JUDGE0_API_KEY=your_auth_token

# Lecture search uses the local transcripts by default, with no paid model calls.
LECTURE_QA_PROVIDER=local
# Optional: use the existing Python Q&A pipeline instead (qa/.env holds its key/model).
# LECTURE_QA_PROVIDER=python
# QA_PYTHON=/absolute/path/to/python
# Optional local explanation model for the lexical search:
# OLLAMA_MODEL=your_local_model
# OLLAMA_BASE_URL=http://127.0.0.1:11434
