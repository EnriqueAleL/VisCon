    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The primary invitation, readiness, or answer action.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Ready to play <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-button-primary{font-family:'Manrope Variable',sans-serif;border:0;border-radius:6px;min-height:45px;padding:12px 20px;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:13px;font-weight:700;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background .15s;background:var(--accent,#6b54ad);color:#fff}.ds-button-primary:hover:not(:disabled){background:#594392}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#a48bce);outline-offset:4px;}.ds-button-primary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A quieter adjacent action with a white surface and fine border.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Back to Play</button>",
      "css": ".ds-button-secondary{font-family:'Manrope Variable',sans-serif;border:0;border-radius:6px;min-height:45px;padding:12px 20px;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:13px;font-weight:700;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background .15s;background:#fff;border:1px solid #d7d4e2;color:var(--ink,#29264b)}.ds-button-secondary:hover:not(:disabled){background:#f6f3fc}.ds-button-secondary:focus-visible{outline:3px solid var(--focus,#a48bce);outline-offset:4px;}.ds-button-secondary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
    },
    {
      "name": "Text Action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "A compact unfilled action for navigation or supporting tasks.",
      "html": "<button class=\"ds-text-button\" type=\"button\">Leave room</button>",
      "css": ".ds-text-button{font-family:'Manrope Variable',sans-serif;display:inline-flex;align-items:center;gap:7px;color:var(--accent,#6b54ad);background:none;border:0;padding:3px 0;font-size:12px;font-weight:650;line-height:1.5;text-align:left;cursor:pointer}.ds-text-button:hover{text-decoration:underline;text-underline-offset:3px}.ds-text-button:focus-visible{outline:3px solid var(--focus,#a48bce);outline-offset:4px;}.ds-text-button:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
