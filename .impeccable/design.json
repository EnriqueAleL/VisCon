  "components": [
    {
      "name": "Workspace Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A direct command in the shared workspace scope.",
      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary{font:500 12px var(--font-ui, Inter, sans-serif);min-height:38px;padding:9px 15px;border:1px solid var(--accent,#69c49a);border-radius:6px;background:var(--accent,#69c49a);color:var(--accent-ink,#101e17)}.ds-primary:hover{background:var(--accent-hover,#86d8b0)}.ds-primary:focus-visible{outline:2px solid var(--focus,#86d8b0);outline-offset:3px}"
    },
    {
      "name": "Workspace Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A neutral secondary command.",
      "html": "<button class=\"ds-secondary\">Cancel</button>",
      "css": ".ds-secondary{font:500 12px var(--font-ui, Inter, sans-serif);min-height:38px;padding:9px 15px;border:1px solid var(--line-strong,#454e58);border-radius:6px;background:var(--surface,#191c1f);color:var(--ink,#edf0f3)}.ds-secondary:hover{background:var(--surface-hover,#292e33)}.ds-secondary:focus-visible{outline:2px solid var(--focus,#86d8b0);outline-offset:3px}"
    },
    {
      "name": "Workspace Field",
      "kind": "input",
      "refersTo": "field",
      "description": "A labeled neutral input with visible focus.",
      "html": "<label class=\"ds-field\">Display name<input placeholder=\"Your name\" /></label>",
      "css": ".ds-field{display:grid;gap:8px;font:500 12px var(--font-ui, Inter, sans-serif);color:var(--muted,#a5adb7)}.ds-field input{font:400 12px var(--font-ui, Inter, sans-serif);height:40px;padding:0 12px;border:1px solid var(--line-strong,#454e58);border-radius:6px;background:var(--surface,#191c1f);color:var(--ink,#edf0f3)}.ds-field input:focus-visible{outline:2px solid var(--focus,#86d8b0);outline-offset:3px}"
    },
    {
      "name": "Versus Primary Button",
      "kind": "button",
      "refersTo": "versus-button-primary",
      "description": "Orbital-blue command with white text; the bright link accent is a separate role.",
      "html": "<button class=\"ds-v-primary\">Create a room</button>",
      "css": ".ds-v-primary{--surface:#0d1524;--surface-raised:#121e31;--surface-hover:#192840;--muted:#a3afc5;--line:#26344c;--line-strong:#40516e;--accent:#a6baff;--focus:#c0ceff;font:500 13px var(--galaxy-body,\"IBM Plex Sans\",sans-serif);min-height:42px;padding:10px 18px;border:1px solid transparent;border-radius:4px;background:var(--galaxy-algebra,#526cb7);color:#fff;cursor:pointer;transition:background .15s,border-color .15s}.ds-v-primary:hover:not(:disabled){background:#4864b3}.ds-v-primary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-v-primary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Versus Secondary Button",
      "kind": "button",
      "refersTo": "versus-button-secondary",
      "description": "Neutral navy command.",
      "html": "<button class=\"ds-v-secondary\">Practice solo</button>",
      "css": ".ds-v-secondary{--surface:#0d1524;--surface-raised:#121e31;--surface-hover:#192840;--muted:#a3afc5;--line:#26344c;--line-strong:#40516e;--accent:#a6baff;--focus:#c0ceff;font:500 13px var(--galaxy-body,\"IBM Plex Sans\",sans-serif);min-height:42px;padding:10px 18px;border:1px solid var(--line-strong);border-radius:4px;background:var(--surface);color:var(--galaxy-starlight,#e9edf6);cursor:pointer;transition:background .15s,border-color .15s}.ds-v-secondary:hover:not(:disabled){background:var(--surface-hover)}.ds-v-secondary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-v-secondary:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Versus Field",
      "kind": "input",
      "refersTo": "versus-field",
      "description": "Labeled navy field with a strong border and visible focus.",
      "html": "<label class=\"ds-v-field\">Display name<input value=\"Alex\" /></label>",
      "css": ".ds-v-field{--surface:#0d1524;--surface-raised:#121e31;--surface-hover:#192840;--muted:#a3afc5;--line:#26344c;--line-strong:#40516e;--accent:#a6baff;--focus:#c0ceff;display:grid;gap:8px;font:500 12px var(--galaxy-body,\"IBM Plex Sans\",sans-serif);color:var(--galaxy-starlight,#e9edf6)}.ds-v-field input{min-width:0;min-height:44px;padding:0 12px;font:400 13px var(--galaxy-body,\"IBM Plex Sans\",sans-serif);background:var(--surface);color:var(--galaxy-starlight,#e9edf6);border:1px solid var(--line-strong);border-radius:4px}.ds-v-field input:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Versus Navigation",
      "kind": "nav",
      "refersTo": "versus-navigation",
      "description": "Existing galaxy breadcrumb above the three competitive destinations.",
      "html": "<div class=\"ds-v-nav\"><nav class=\"ds-v-trail\" aria-label=\"Platform breadcrumb\"><a href=\"/\">Galaxy</a><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg><span aria-current=\"page\">Versus</span></nav><nav class=\"ds-v-tabs\" aria-label=\"Versus navigation\"><button aria-current=\"page\">Play</button><button>Match history</button><button>Leaderboard</button></nav></div>",
      "css": ".ds-v-nav{--surface:#0d1524;--surface-raised:#121e31;--surface-hover:#192840;--muted:#a3afc5;--line:#26344c;--line-strong:#40516e;--accent:#a6baff;--focus:#c0ceff;background:var(--galaxy-void,#070a12);color:var(--muted);padding:10px 18px 0}.ds-v-trail{display:flex;align-items:center;gap:12px;font:600 12px/1.5 var(--galaxy-display,\"Chakra Petch\",sans-serif);text-transform:uppercase;letter-spacing:.06em}.ds-v-trail a{color:var(--muted);padding-block:6px;text-decoration:none}.ds-v-trail span{color:var(--accent)}.ds-v-tabs{display:flex;gap:26px;border-bottom:1px solid var(--line);margin-top:10px}.ds-v-tabs button{font:400 13px var(--galaxy-body,\"IBM Plex Sans\",sans-serif);border:0;border-bottom:2px solid transparent;padding:14px 0;background:none;color:var(--muted);cursor:pointer;white-space:nowrap}.ds-v-tabs [aria-current]{color:var(--accent);border-bottom-color:var(--accent)}.ds-v-nav a:hover,.ds-v-tabs button:hover{color:var(--galaxy-starlight,#e9edf6)}.ds-v-nav a:focus-visible,.ds-v-tabs button:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Versus Mode Badge",
      "kind": "chip",
      "refersTo": "versus-badge",
      "description": "The existing compact badge records mode; it is not an action.",
      "html": "<span class=\"ds-v-badge\">Friendly</span>",
      "css": ".ds-v-badge{--surface:#0d1524;--surface-raised:#121e31;--surface-hover:#192840;--muted:#a3afc5;--line:#26344c;--line-strong:#40516e;--accent:#a6baff;--focus:#c0ceff;display:inline-flex;align-items:center;gap:5px;padding:4px 7px;background:var(--surface-raised);border:1px solid var(--line);border-radius:4px;color:var(--muted);font:500 10px var(--galaxy-body,\"IBM Plex Sans\",sans-serif);white-space:nowrap}"
    },
    {
      "name": "Versus Question Panel",
      "kind": "card",
      "refersTo": "versus-question-panel",
      "description": "Bounded question reading surface; no decorative shadow.",
      "html": "<section class=\"ds-v-question\"><h2>Question 1</h2><p>Which statement describes the instruction?</p></section>",
      "css": ".ds-v-question{--surface:#0d1524;--surface-raised:#121e31;--surface-hover:#192840;--muted:#a3afc5;--line:#26344c;--line-strong:#40516e;--accent:#a6baff;--focus:#c0ceff;padding:24px;background:var(--surface);border:1px solid var(--line);border-radius:6px;color:var(--galaxy-starlight,#e9edf6);min-width:0}.ds-v-question h2{font:600 25px/1.35 var(--galaxy-display,\"Chakra Petch\",sans-serif);margin:0 0 12px}.ds-v-question p{font:400 15px/1.85 var(--galaxy-body,\"IBM Plex Sans\",sans-serif);max-width:65ch;margin:0}"
    },
    {
      "name": "Versus Cockpit Communications",
      "kind": "custom",
      "description": "Textual combat result and native rules disclosure beneath the 3D window; remains available with effects paused or WebGL unavailable.",
      "html": "<div class=\"ds-cockpit-comms\"><p role=\"status\"><span class=\"ds-comms-light\"></span>Correct answer · direct hit</p><details class=\"ds-combat-rules\"><summary>Combat rules</summary><p>A correct answer fires at the other ship. A missed answer draws return fire. If both pilots are correct, both fire. Exchanges appear after the round closes. Each correct answer still earns 1,000 points; total score decides the winner.</p></details></div>",
      "css": ".ds-cockpit-comms{--surface:#0d1524;--muted:#a3afc5;--line-strong:#40516e;--focus:#c0ceff;display:flex;align-items:center;justify-content:space-between;gap:20px;background:var(--surface);color:var(--galaxy-starlight,#e9edf6);padding:12px 20px;min-height:47px;font-family:var(--galaxy-body,\"IBM Plex Sans\",sans-serif)}.ds-cockpit-comms>p{margin:0;font-size:13px;display:flex;align-items:center;gap:10px}.ds-comms-light{width:5px;height:5px;border-radius:50%;flex-shrink:0;background:#9ccdb1}.ds-combat-rules{position:relative;flex-shrink:0}.ds-combat-rules summary{font-size:12px;color:var(--muted);cursor:pointer}.ds-combat-rules summary:hover{color:var(--galaxy-starlight,#e9edf6)}.ds-combat-rules summary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-combat-rules p{position:absolute;right:0;z-index:8;width:min(340px,78vw);border:1px solid var(--line-strong);padding:16px;background:var(--surface);color:var(--galaxy-starlight,#e9edf6);font-size:13px;line-height:1.7}@media(max-width:780px){.ds-cockpit-comms{align-items:flex-start;padding:12px 14px;gap:10px}.ds-cockpit-comms>p{font-size:12px;line-height:1.6}.ds-combat-rules summary{font-size:11px;line-height:1.7}}@media(max-width:370px){.ds-cockpit-comms{flex-wrap:wrap}.ds-combat-rules p{left:0;right:auto}}"
    }
  ],
  "narrative": {
    "northStar": "One VisCon workspace",
    "overview": "VisCon connects course exploration, lecture study and competition. Its existing galaxy supplies the spatial identity for Versus: dark navy space, angular headings, readable text and precise orbital geometry. The user-authorized ship and cockpit extension gives this competitive destination a physical place in that universe: boarding approaches the ship, and completed round results drive brief combat exchanges. This continues the existing galaxy, recorded in PRODUCT.md on 10 October 2026; it does not replace the identities of the other workspaces.\n\nStudy World, Lectures, Campus controls and the standalone video demonstration retain the incumbent charcoal, Inter and green system. These workspaces keep their direct, compact study workflows and shared product header. NeetCode Versus remains a functional reference for match setup and invitations, not the visual authority for the galaxy destination.",
    "keyCharacteristics": [
      "Existing galaxy and Versus share space, typography and course-aware navigation.",
      "The galaxy ship and Versus cockpit share procedural geometry; confirmed results drive bounded combat effects.",
      "Other workspaces retain charcoal neutrals, local Inter and green actions.",
      "Clear questions, subject availability, scores and results take priority over decoration.",
      "Fine boundaries and tonal surfaces organize compact controls.",
      "Native video, code workspaces and accessible interaction remain intact."
    ],
