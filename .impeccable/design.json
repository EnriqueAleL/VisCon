      "kind": "input",
      "refersTo": "field",
      "description": "A standard editable profile or configuration field.",
      "html": "<div class=\"ds-field\"><label for=\"ds-display-name\">Display name</label><input id=\"ds-display-name\" value=\"Mateo\" placeholder=\"Your name\" minlength=\"2\" maxlength=\"24\"></div>",
      "css": ".ds-field{font-family:'Manrope Variable',sans-serif;color:var(--ink,#29264b)}.ds-field label{display:block;font-size:12px;font-weight:700;line-height:1.5;margin-bottom:9px}.ds-field input{font-family:'Manrope Variable',sans-serif;width:100%;height:47px;border:1px solid #d4d7e2;border-radius:6px;padding:0 13px;color:var(--ink,#29264b);background:#fff;font-size:12px;min-width:0;caret-color:var(--accent,#6b54ad)}.ds-field input::placeholder{color:var(--muted,#685d75);opacity:1}.ds-field input:focus-visible{outline:3px solid var(--focus,#a48bce);outline-offset:4px;}.ds-field input:disabled{background:#f8f9fc;color:#716b80}@media(max-width:650px){.ds-field label{font-size:11px}.ds-field input{font-size:11px;height:44px;padding:0 9px}}"
    },
