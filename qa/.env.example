# Copy to .env (never commit .env).
OPENAI_API_KEY=sk-...

# Model used to build the chapter index (once per lecture) and to answer questions.
# `python -m viscon_qa models` lists the models your key can use.
QA_INDEX_MODEL=
# Optional: a cheaper model for answering; defaults to QA_INDEX_MODEL.
QA_ANSWER_MODEL=

# Optional overrides (relative to the qa/ folder).
# QA_LECTURES_DIR=../lectures
# QA_INDEX_PATH=data/index.json
